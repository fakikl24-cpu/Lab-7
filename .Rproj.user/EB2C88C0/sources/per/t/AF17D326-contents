##Exercise 4

```{r exercise-4}

library(MASS)
library(dplyr)

# Number of simulations
n_sims <- 100

# Fixed parameters
n_colonists <- 100

mean_traits <- c(-0.5, 0.5, 0.25, 0.5, 0)

sd_traits <- c(1, 0.9, 1, 1, 1)

var_names <- c("EX", "ES", "AG", "CO", "OP")

# Correlation matrix
cor_matrix_bigfive <- matrix(
  c(
    1.0000, 0.2599, 0.1972, 0.1860, 0.2949,
    0.2599, 1.0000, 0.1576, 0.2306, 0.0720,
    0.1972, 0.1576, 1.0000, 0.2866, 0.1951,
    0.1860, 0.2306, 0.2866, 1.0000, 0.1574,
    0.2949, 0.0720, 0.1951, 0.1574, 1.0000
  ),
  nrow = 5,
  byrow = TRUE
)

# Convert correlation matrix to covariance matrix
cov_matrix <- cor_matrix_bigfive * (sd_traits %*% t(sd_traits))

# Run simulations and append results
simulation_results <- replicate(n_sims, {

  traits <- mvrnorm(
    n = n_colonists,
    mu = mean_traits,
    Sigma = cov_matrix
  )

  traits <- as.data.frame(traits)
  names(traits) <- var_names

  data.frame(
    mean_EX = mean(traits$EX),
    sd_EX = sd(traits$EX),
    cor_EX_OP = cor(traits$EX, traits$OP)
  )

}, simplify = FALSE) %>%
  bind_rows(.id = "simulation")

# Summary across simulations
final_summary <- simulation_results %>%
  group_by() %>%
  summarize(
    avg_mean_EX = mean(mean_EX),
    sd_mean_EX = sd(mean_EX),

    avg_sd_EX = mean(sd_EX),
    sd_sd_EX = sd(sd_EX),

    avg_cor_EX_OP = mean(cor_EX_OP),
    sd_cor_EX_OP = sd(cor_EX_OP)
  )

# View outputs
simulation_results
final_summary

# Plots 

library(ggplot2)
library(dplyr)

# Histogram of simulated colony means for Extraversion
ggplot(simulation_results, aes(x = mean_EX)) +
  geom_histogram(
    bins = 15,
    fill = "steelblue",
    color = "black"
  ) +
  geom_vline(
    xintercept = -0.5,
    color = "red",
    linewidth = 1
  ) +
  annotate(
    "text",
    x = -0.5,
    y = Inf,
    label = "Population Mean = -0.5",
    vjust = 2,
    color = "red"
  ) +
  labs(
    title = "Distribution of Simulated Mean Extraversion",
    x = "Sample Mean of Extraversion",
    y = "Frequency"
  ) +
  theme_minimal()



# Histogram of simulated SDs for Extraversion
ggplot(simulation_results, aes(x = sd_EX)) +
  geom_histogram(
    bins = 15,
    fill = "darkgreen",
    color = "black"
  ) +
  geom_vline(
    xintercept = 1,
    color = "red",
    linewidth = 1
  ) +
  annotate(
    "text",
    x = 1,
    y = Inf,
    label = "Population SD = 1",
    vjust = 2,
    color = "red"
  ) +
  labs(
    title = "Distribution of Simulated SD of Extraversion",
    x = "Sample SD of Extraversion",
    y = "Frequency"
  ) +
  theme_minimal()



# Histogram of simulated correlations between EX and OP
ggplot(simulation_results, aes(x = cor_EX_OP)) +
